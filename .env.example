# KAWACH (कवच) - Production Environment Variables Example
# Copy to .env for local deployment. Do NOT commit real secrets to source control.

# Core AI & Maps Integration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="AIzaSy..."
APP_URL="https://kawach.org"

# Server & Network Ports
PORT=3000
PYTHON_PORT=8000
PYTHON_HOST="0.0.0.0"

# Application Security
APP_SECRET_KEY="replace-with-a-random-64-character-cryptographic-secret"
TOKEN_EXPIRY_HOURS=24
EMERGENCY_LINK_EXPIRY_HOURS=2
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=15
MAX_OTP_ATTEMPTS=3

# Persistent Database File Path
HER_SAFE_DB_PATH="her_safe_db.json"

# Production SMS Providers (Options: twilio, fast2sms, aws_sns, console_fallback)
SMS_PROVIDER="console_fallback"

# Twilio SMS Configuration (Optional)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Fast2SMS Configuration for India (Optional)
FAST2SMS_API_KEY="your_fast2sms_api_key"

# Cloud Storage Vault Configuration (1 TB default allocation)
STORAGE_BUCKET_NAME="ai-studio-kawach-vault"
MAX_EVIDENCE_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=60
