rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidToken(token) {
      return token is string && token.size() >= 8 && token.size() <= 128 && token.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // 1.1 Contacts subcollection
      match /contacts/{contactId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(contactId);
        allow delete: if isOwner(userId);
      }

      // 1.2 Safety Timers subcollection
      match /safety_timers/{timerId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(timerId);
        allow delete: if isOwner(userId);
      }

      // 1.3 Journeys subcollection
      match /journeys/{journeyId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(journeyId);
        allow delete: if isOwner(userId);
      }
    }

    // 2. Emergency SOS Sessions
    match /emergency_sessions/{sessionId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sessionId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // 2.1 Location Breadcrumbs
      match /location_updates/{updateId} {
        allow get, list: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/emergency_sessions/$(sessionId)).data.userId;
        allow create: if isSignedIn() && isValidId(updateId) && request.resource.data.userId == request.auth.uid;
      }
    }

    // 3. Ephemeral Public Location Shares (accessed via emergency token link)
    match /public_shares/{shareToken} {
      allow get: if isValidToken(shareToken);
      allow list: if false;
      allow create: if isSignedIn() && isValidToken(shareToken) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidToken(shareToken) && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
